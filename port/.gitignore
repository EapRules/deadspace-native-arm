# The user's own APK: never redistributed, never committed.
*.apk
build/
# The game's writable storage (savegames, caches). Created at runtime; the
# port's .sh points DEADSPACE_DATA_DIR at the PortMaster data directory.
gamedata/
harness/results/
harness/control/*.armhf

# qemu-user drops core files in the working directory on a guest abort.
qemu_*.core
__pycache__/
